{
  "manifestVersion": 5,
  "id": "com.hughp.folderwatch",
  "name": "Folder Watch",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "folderWatchPanel",
      "label": {
        "default": "Folder Watch"
      },
      "minimumSize": {
        "width": 260,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 390,
        "height": 720
      }
    }
  ]
}
